{
  "name": "desktop",
  "version": "0.0.1",
  "private": true,
  "description": "Overly for you",
  "keywords": [],
  "license": "MIT",
  "author": {
    "name": "SelvaGaneshV",
    "email": "v.a.ganesh8@gmail.com"
  },
  "main": "dist/main.cjs",
  "scripts": {
    "dev": "tsdown && concurrently -n tsdown,electron -c blue,magenta \"tsdown --watch\" \"electron .\"",
    "build": "tsdown",
    "dist": "node -e \"require('fs').rmSync('dist/renderer',{recursive:true,force:true}); require('fs').cpSync('../web/dist','dist/renderer',{recursive:true})\" && electron-builder",
    "start": "electron .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.4",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@types/node": "catalog:",
    "ai": "^7.0.136",
    "concurrently": "^10.0.6",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "hono": "^4.13.13",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "build": {
    "appId": "com.overlychat.app",
    "productName": "Overly Chat",
    "compression": "maximum",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/icons/png/256x256.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icons/win/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icons/mac/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icons/png/512x512.png"
    }
  },
  "productName": "Overly Chat"
}
